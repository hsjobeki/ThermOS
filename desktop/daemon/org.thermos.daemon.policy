<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>ThermOS</vendor>

  <action id="org.thermos.daemon.start-update">
    <description>Start a ThermOS system update</description>
    <message>Authentication is required to start a system update</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:thermos-daemon</annotate>
  </action>

  <action id="org.thermos.daemon.apply-update">
    <description>Apply a downloaded ThermOS system update</description>
    <message>Authentication is required to apply a system update</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:thermos-daemon</annotate>
  </action>
</policyconfig>
